{
  "name": "@scavio/mcp-server",
  "version": "0.14.0",
  "mcpName": "io.github.scavio-ai/scavio-mcp",
  "description": "MCP server connecting AI agents to Scavio: web search, page extraction, and structured e-commerce, social, travel, jobs, real-estate, app-store, ad-library and company-filing data. 191 tools across 31 platforms plus Extract, one API key.",
  "type": "module",
  "license": "MIT",
  "author": "Scavio",
  "homepage": "https://scavio.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scavio-ai/scavio-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/scavio-ai/scavio-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "scavio",
    "google",
    "youtube",
    "amazon",
    "walmart",
    "tiktok",
    "reddit",
    "x",
    "linkedin",
    "web-search",
    "instagram",
    "threads",
    "ebay",
    "zillow",
    "yelp",
    "indeed",
    "glassdoor",
    "sec-filings",
    "web-scraping",
    "url-extraction",
    "tavily-alternative",
    "serpapi-alternative"
  ],
  "bin": {
    "scavio-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "toolslist": "node scripts/toolslist.mjs",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.12",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
