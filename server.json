{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.scavio-ai/scavio-mcp",
  "title": "Scavio",
  "description": "Structured web data from 45 platforms: Google, ChatGPT, Gemini, YouTube, Amazon, Reddit, TikTok",
  "version": "0.25.0",
  "repository": {
    "url": "https://github.com/scavio-ai/scavio-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@scavio/mcp-server",
      "version": "0.25.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SCAVIO_API_KEY",
          "description": "Your Scavio API key from scavio.dev",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.scavio.dev/mcp",
      "authorizationUrl": "https://mcp.scavio.dev/.well-known/oauth-authorization-server"
    }
  ]
}
